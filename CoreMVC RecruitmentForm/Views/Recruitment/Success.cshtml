@model RecruitmentCoreMVC.Models.Candidate
@{
    ViewData["Title"] = "Application Submitted";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<div class="container mt-5">
    <div class="alert alert-success shadow">
        @ViewBag.Message
    </div>
    <a asp-action="Create" asp-controller="Recruitment" class="btn btn-outline-dark">Submit another application</a>
</div>
</body>
</html>
